# 定义目标平台
GOOS ?= $(OS)
GOARCH ?= $(ARCH)

# 输出文件名
OUTPUT = $(TARGET_PATH)/$(TARGET_NAME)-$(GOOS)-$(GOARCH)$(SUFFIX)


# 默认构建目标
build:
	# "--- Building $(TARGET_NAME) for $(GOOS)-$(GOARCH) ... ---"
	GOOS=$(GOOS) GOARCH=$(GOARCH) CC=$(BUILD_CC) CXX=$(BUILD_CC) CGO_ENABLED=1 go build -ldflags "-s -w"  -o $(OUTPUT) $(SRC_PATH)
	# "--- Build $(TARGET_NAME) for $(GOOS)-$(GOARCH) success !!! ---"
clean:
	rm -rf build/
